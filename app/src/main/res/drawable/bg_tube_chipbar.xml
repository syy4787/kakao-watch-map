<?xml version="1.0" encoding="utf-8"?>
<!-- 칩 줄의 칩 (유튜브 앱처럼): 고른 칩은 흰 바탕, 나머지는 어두운 회색 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33888888">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/text_primary" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tube_chip" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
