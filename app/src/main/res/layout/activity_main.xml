<?xml version="1.0" encoding="utf-8"?>
<!--
  원형 워치 지도 화면
  · MapView 를 정사각형 화면 전체에 깔면 원형 디스플레이에서는 원 전체가 지도로 꽉 찬다.
  · 버튼·안내·경로 카드 위치는 MainActivity 가 원 안에 들어가도록 계산해서 놓는다.
  · 맨 바깥 SwipeDismissFrameLayout: 왼쪽 가장자리 스와이프 = 앱 닫기
-->
<androidx.wear.widget.SwipeDismissFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.mywatch.kakaomap.PannableFrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.kakao.vectormap.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 안내 배너 (카카오맵 길안내처럼): 왼쪽 [화살표·탈것 아이콘 + 거리], 오른쪽 [짧은 할 일(굵게) + 장소 하나].
             글자 폭만큼만 차지하고 원 위쪽 가장자리에 붙는다. 톡 → 둘째 줄 접기 / 다시 톡 → 펼치기 -->
        <LinearLayout
            android:id="@+id/guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/bg_guide"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/guide_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_walk"
                    android:tint="@android:color/white" />

                <TextView
                    android:id="@+id/guide_dist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/guide_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/guide_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 새 버전 알림 -->
        <TextView
            android:id="@+id/update_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/bg_update_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/update_available"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 남은 거리 · 도착 시각 한 줄 (톡 → 경로 상세). 안내 종료는 지도를 톡 하면 나오는 ✕ 버튼 -->
        <TextView
            android:id="@+id/route_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_route_pill"
            android:elevation="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="@color/text_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_status"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_search"
            style="@style/RingButton"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_directions" />

        <ImageButton
            android:id="@+id/btn_zoom_in"
            style="@style/RingButton"
            android:contentDescription="@string/zoom_in"
            android:src="@drawable/ic_zoom_in" />

        <ImageButton
            android:id="@+id/btn_my_location"
            style="@style/RingButton"
            android:contentDescription="@string/my_location"
            android:src="@drawable/ic_my_location" />

        <ImageButton
            android:id="@+id/btn_zoom_out"
            style="@style/RingButton"
            android:contentDescription="@string/zoom_out"
            android:src="@drawable/ic_zoom_out" />

        <!-- 안내 종료 (경로가 있을 때 지도를 톡 하면 3시 방향에 잠깐 보임) -->
        <ImageButton
            android:id="@+id/btn_end"
            style="@style/RingButton"
            android:contentDescription="@string/end_route"
            android:src="@drawable/ic_close"
            android:tint="@color/end_red" />

        <!-- 저전력(앰비언트) 화면: 손목을 내렸을 때 검은 바탕에 안내만 표시해 배터리를 아낀다.
             elevation 이 높아야 그림자가 있는 흰 카드·버튼보다 위에 그려져 모두 가린다 (번인·전력 방지).
             번인 방지용 화면 이동은 시스템이 알아서 한다 -->
        <FrameLayout
            android:id="@+id/ambient_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:clickable="true"
            android:elevation="24dp"
            android:focusable="false"
            android:visibility="gone">

            <!-- 선만 그린 미니 지도 + 다음 안내 (지도 엔진·네트워크 없이 직접 그림) -->
            <com.mywatch.kakaomap.ui.AmbientRouteView
                android:id="@+id/ambient_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

    </com.mywatch.kakaomap.PannableFrameLayout>
</androidx.wear.widget.SwipeDismissFrameLayout>
