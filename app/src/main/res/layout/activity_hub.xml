<?xml version="1.0" encoding="utf-8"?>
<!-- 갤럭시워치 전용앱 첫 화면: 카카오맵 / 유튜브 고르기 (둥근 화면 가운데에 큰 동그라미 두 개) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

        <TextView
        android:id="@+id/hub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/app_name"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/open_map"
            android:layout_width="86dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hub_item"
            android:contentDescription="@string/hub_map_desc"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_hub_map"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_place"
                android:tint="@color/ic_launcher_pin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/hub_map"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hub_map_sub"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/open_tube"
            android:layout_width="86dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_hub_item"
            android:contentDescription="@string/hub_tube_desc"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_hub_tube"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_music_note"
                android:tint="@color/ic_tube_note" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/hub_tube"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hub_tube_sub"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 아래 줄: 업데이트 | 배터리(동그란 아이콘). 둥근 화면 아래쪽은 좁아서(가장 아래 가로폭 약 144dp) 글자 버튼은 하나만 두고
         배터리는 40dp 동그라미 — 글자를 키운 워치에서도 양 끝이 잘리지 않는다.
         업데이트: 앱을 열면 바로 보이게 (예전 '앱 정보 · 업데이트' 작은 글씨는 큰 글꼴에서 화면 끝에 밀려 안 보였음).
         새 버전이 있으면 파랗게. 누르면 확인하고 곧바로 받아 설치 (앱 정보·오류 기록도 그 화면에).
         배터리: 15분마다 쌓인 배터리 기록·판정 화면 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hub_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_action"
            android:drawableStart="@drawable/ic_download"
            android:drawablePadding="6dp"
            android:drawableTint="@color/text_primary"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingVertical="6dp"
            android:text="@string/hub_update"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/open_battery"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_action"
            android:contentDescription="@string/hub_battery_desc"
            android:padding="9dp"
            android:src="@drawable/ic_battery"
            android:tint="@color/text_primary" />
    </LinearLayout>
</LinearLayout>
