<?xml version="1.0" encoding="utf-8"?>
<!-- 도보·자전거 경로 옵션 카드 (카카오맵: 자전거도로 우선 · 최단 거리 · 편안한 길 / 큰길 우선 …).
     고른 카드는 테두리, 가장 빨리 도착하는 카드는 '가장 빠름' -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_route_option"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/badge"
            style="@style/FastestBadge"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- 큰 글씨 시간 + 작은 글씨 거리·도착 시각을 한 글상자에 — 시간이 길면 나머지가 다음 줄로 흐른다 -->
    <TextView
        android:id="@+id/time_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
