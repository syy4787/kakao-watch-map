<?xml version="1.0" encoding="utf-8"?>
<!-- 대중교통 경로 한 개: (가장 빠름) 총 시간 · 도착 시각 · 요금 · 환승 · 구간 막대 · 첫 승차 + 실시간 도착 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="11dp">

    <TextView
        android:id="@+id/badge"
        style="@style/FastestBadge"
        android:layout_marginBottom="2dp" />

    <!-- 총 시간(굵게) + 도착 시각(작게) 한 줄 — '1시간 41분'처럼 길면 도착 시각만 다음 줄로 (코드에서 글자 크기를 나눔) -->
    <TextView
        android:id="@+id/time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <!-- 요금 · 환승 · 도보 — 요금이 '1,500~3,150원'처럼 길면 두 줄로 (항목은 코드에서 붙은 빈칸으로 묶어 통째로 줄바꿈) -->
    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <com.mywatch.kakaomap.ui.SegmentBarView
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="7dp" />

    <TextView
        android:id="@+id/first"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <!-- 실시간 도착 — '106번 3분 (2번째 전) · 놓칠 수 있어요 · 다음 15분' 이면 세 줄까지 -->
    <TextView
        android:id="@+id/live"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/live"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
