<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wear OS 전용 앱 -->
    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />

    <!-- 지도·검색·길찾기·업데이트 다운로드 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 내 위치 (출발지·안내) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 자체 업데이트: 새 APK 설치 (워치에선 처음 한 번 ADB 로 허용) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- 안내 중 저전력(앰비언트) 화면 유지 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- '안내 시작' 후 화면이 꺼져도 위치를 받아 진동으로 안내 (위치 포그라운드 서비스) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 안내 알림 / 워치페이스의 '진행 중' 아이콘 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 안내 알림을 '실시간 업데이트'(Live Update)로 올리기 — Wear OS 7 에서 진행 중 활동 대신 쓰임 (설치 시 자동 허용) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:name=".MapApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KakaoWatchMap">

        <!-- 앰비언트 모드용 Wear 공유 라이브러리 (없어도 설치는 됨) -->
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- 휴대폰 앱 없이 워치 단독으로 동작 -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- 워치 앱 목록의 아이콘은 '갤럭시워치 전용앱' 하나: 들어가면 카카오맵 / 유튜브를 고른다.
             고른 앱은 저마다의 작업(task)으로 열리고 이 화면은 스스로 닫히므로 최근 앱 목록에는 남기지 않는다.
             noHistory 는 쓰지 않는다 — '앱 정보'를 열었다 뒤로 오면 이 고르는 화면이 있어야 해서 -->
        <activity
            android:name=".ui.HubActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.mywatch.kakaomap.hub"
            tools:ignore="WearRecents">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 지도의 모든 화면은 한 작업(task)으로: 워치 '최근 앱'에 한 번만, 알림·진행 중 아이콘을 눌러도 같은 지도로 돌아옴 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_map_launcher"
            android:label="@string/map_name"
            android:launchMode="singleTop"
            android:taskAffinity="com.mywatch.kakaomap.main" />

        <!-- 타일의 '집으로·회사로·검색' 버튼이 바로 여는 화면이라 exported (받는 값은 집/회사/검색 세 가지뿐).
             singleTop: 위에 지도가 있을 수 있어 아래 화면을 치우지 않는다 (옛 길찾기 화면은 스스로 닫힘) -->
        <activity
            android:name=".ui.SearchActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.mywatch.kakaomap.main" />
        <activity
            android:name=".ui.DirectionsActivity"
            android:exported="false"
            android:taskAffinity="com.mywatch.kakaomap.main" />
        <activity
            android:name=".ui.RouteDetailActivity"
            android:exported="false"
            android:taskAffinity="com.mywatch.kakaomap.main" />
        <!-- 유튜브 음악: 첫 화면에서 고르거나 타일로 연다(타일이 열므로 exported). 지도와 다른 작업(task)이라 최근 앱에서도 따로 보인다.
             찾은 곡은 폰의 유튜브 앱이 재생한다 (워치는 검색·고르기만) -->
        <activity
            android:name=".ui.TubeActivity"
            android:exported="true"
            android:icon="@mipmap/ic_tube"
            android:label="@string/tube_app_name"
            android:launchMode="singleTop"
            android:taskAffinity="com.mywatch.kakaomap.tube" />
        <activity
            android:name=".update.UpdateActivity"
            android:exported="false"
            android:taskAffinity="com.mywatch.kakaomap.main" />

        <service
            android:name=".nav.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- 타일: 워치 화면을 옆으로 넘기면 나오는 '집으로·회사로·검색' 카드 -->
        <service
            android:name=".tile.ShortcutTileService"
            android:exported="true"
            android:icon="@drawable/ic_directions"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>
        <!-- 타일 '유튜브 음악': 노래 검색(말로) · 믹스 이어 듣기 · 열기 -->
        <service
            android:name=".tile.TubeTileService"
            android:exported="true"
            android:icon="@drawable/ic_music_note"
            android:label="@string/tube_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_tube_preview" />
        </service>
    </application>
</manifest>
